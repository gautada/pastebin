<div id="dropzone" class="dropzone" tabindex="0" aria-label="Upload or paste zone">
  <!-- Dropzone view -->
  <div id="dz-view">
    <p><strong>Drag &amp; drop</strong> files here</p>
    <p>or <strong>paste</strong> from clipboard (Ctrl/⌘ + V)</p>
    <p>or</p>

    <div class="row">
      <input id="file-input" type="file" multiple />
      <button id="upload-btn" type="button">Upload selected</button>
    </div>

    <p class="hint">Tip: double-click or start typing to paste plain text instead.</p>
  </div>

  <!-- Text view (hidden by default) -->
  <div id="text-view" class="card" style="display:none;">
    <form id="paste-form">
      <label for="pasteContent"><strong>Paste content</strong></label><br />
      <textarea
        id="paste-content"
        name="content"
        rows="12"
        style="min-width:88ch;"
        placeholder="Type or paste plain text here..."
      ></textarea>

      <div class="row" style="margin-top:12px;">
        <label>
          Language:
          <select id="paste-lang" name="language">
            <option value="plaintext">Plain text</option>
            <option value="json">JSON</option>
            <option value="yaml">YAML</option>
            <option value="bash">Bash</option>
            <option value="python">Python</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="sql">SQL</option>
          </select>
        </label>

        <button id="paste-btn" type="submit">Create link</button>
        <button id="cancel-text-btn" type="button">Cancel</button>
      </div>

      <p class="hint" style="margin-top:8px;">Esc or Cancel returns to file drop mode.</p>
    </form>
  </div>
</div>

